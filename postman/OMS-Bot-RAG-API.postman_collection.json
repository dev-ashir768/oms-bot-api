{
  "info": {
    "name": "OMS Bot - RAG API",
    "_postman_id": "oms-bot-rag-api",
    "description": "RAG Backend API with PDF ingestion, chat with caching/streaming, tracking, session management, multi-key rotation, rate limiting, and API key auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key" },
      { "key": "value", "value": "{{apiKey}}" },
      { "key": "in", "value": "header" }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "apiKey",
      "value": "your-api-key-here"
    },
    {
      "key": "userId",
      "value": "OR-00009"
    },
    {
      "key": "sessionId",
      "value": "session_001"
    },
    {
      "key": "userName",
      "value": "Orio OMS Demo"
    }
  ],
  "item": [
    {
      "name": "Health",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Gemini Key Pool Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health/gemini",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "gemini"
              ]
            },
            "description": "Shows the status of every configured Gemini API key — cooldown remaining and failure count. Useful for debugging rate-limit rotation."
          }
        }
      ]
    },
    {
      "name": "Ingest",
      "item": [
        {
          "name": "Ingest Text Documents",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/rag/ingest/text",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rag",
                "ingest",
                "text"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documents\": [\n    \"OMS Bot is an order management system that handles inventory, shipping, and customer orders.\",\n    \"The system supports real-time order tracking and integrates with multiple shipping carriers.\",\n    \"Users can manage their product catalog, set pricing rules, and automate fulfillment workflows.\",\n    \"The API provides endpoints for order creation, status updates, and bulk operations.\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Ingest PDF",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/rag/ingest/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rag",
                "ingest",
                "pdf"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Select a PDF file to ingest"
                },
                {
                  "key": "chunkSize",
                  "value": "1000",
                  "type": "text",
                  "description": "Characters per chunk (optional, default 1000)"
                },
                {
                  "key": "chunkOverlap",
                  "value": "200",
                  "type": "text",
                  "description": "Overlap between chunks (optional, default 200)"
                }
              ]
            }
          }
        },
        {
          "name": "Get Index Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rag/ingest/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rag",
                "ingest",
                "stats"
              ]
            }
          }
        },
        {
          "name": "Reset Knowledge Base (⚠️ Deletes All)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/rag/ingest/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rag",
                "ingest",
                "reset"
              ]
            },
            "description": "⚠️ DESTRUCTIVE. Clears the entire FAISS index and ingested_documents log. All previously ingested PDFs/text will be gone — you'll need to re-ingest. Protected by API key auth."
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Chat Stream (SSE)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/chat/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "stream"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"userName\": \"{{userName}}\",\n  \"message\": \"Explain how the API endpoints work.\"\n}"
            },
            "description": "Server-Sent Events endpoint. Response streams as: event:meta → event:chunk (many) → event:done. Frontend consumes via ReadableStream."
          }
        },
        {
          "name": "Chat (New Session)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"sessionId\": \"session_002\",\n  \"userName\": \"{{userName}}\",\n  \"message\": \"Tell me about the API endpoints available.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Sessions & History",
      "item": [
        {
          "name": "Get User Sessions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chat/history/{{userId}}/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "history",
                "{{userId}}",
                "{{sessionId}}"
              ]
            }
          }
        },
        {
          "name": "Rename Session",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"title\": \"My Custom Chat Title\"\n}"
            },
            "description": "Rename any session. Returns 404 if session doesn't belong to this user."
          }
        },
        {
          "name": "Delete Session",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{sessionId}}?userId={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions",
                "{{sessionId}}"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Deletes a session AND all its messages (cascade). Returns 404 if session doesn't belong to this user."
          }
        }
      ]
    }
  ]
}