# ==============================
# PostgreSQL
# ==============================
DATABASE_URL=

# ==============================
# Google Gemini
# ==============================
# Single key:
GEMINI_API_KEY=
# OR multiple keys (comma-separated) for rate-limit rotation:
# GEMINI_API_KEYS=key1,key2,key3

GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Cheap (recommended): gemini-3.5-flash-lite | gemini-3.5-flash-lite
# Standard: gemini-3.5-flash-lite | gemini-3.8-flash | gemini-flash-latest
# Check available: curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_DIMENSION=768

# ==============================
# Server
# ==============================
PORT=8001
NODE_ENV=development

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# ==============================
# API Authentication
# ==============================
# Frontend must send this in the X-API-Key header on every /api/* request.
# Leave empty to disable auth (NOT recommended for production).
# Generate a strong random string: openssl rand -hex 32
API_KEY=

# ==============================
# RAG Settings (token optimization)
# ==============================
# Number of context chunks retrieved from FAISS (1-5). Lower = fewer tokens.
RAG_TOP_K=2

# Recent history messages included in the prompt (2-10). Lower = fewer tokens.
CHAT_HISTORY_LIMIT=4

# Truncate each history message to this many chars (avoids runaway token cost).
HISTORY_MESSAGE_MAX_CHARS=300

# Truncate each RAG chunk to this many chars.
RAG_CHUNK_MAX_CHARS=500

# Max tokens the AI can output per reply (256-1024). Lower = cheaper + faster.
MAX_OUTPUT_TOKENS=512

# ==============================
# Response Cache
# ==============================
# Semantic similarity threshold (0.80 loose ─ 0.95 strict). Lower = more cache hits.
CACHE_SIMILARITY_THRESHOLD=0.88

# ==============================
# FAISS
# ==============================
FAISS_INDEX_DIR=./data/faiss_index

# ==============================
# Tracking API (Orio)
# ==============================
TRACKING_API_URL=https://getorio.com/api/universal_tracking

# ==============================
# Bot Identity
# ==============================
BOT_NAME=Orio OMS Assistant
# SYSTEM_PROMPT=  (optional: override the entire default system prompt)

# ==============================
# PDF Upload
# ==============================
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./data/uploads
