# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/oms_bot

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Server
PORT=3000
NODE_ENV=development

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# FAISS
FAISS_INDEX_DIR=./data/faiss_index

# RAG Settings
RAG_TOP_K=4
CHAT_HISTORY_LIMIT=10
EMBEDDING_DIMENSION=768

# Response Cache (0.0 to 1.0 — higher = stricter match required)
CACHE_SIMILARITY_THRESHOLD=0.92

# Tracking API
TRACKING_API_URL=https://getorio.com/api/universal_tracking

# Bot Identity
BOT_NAME=OMS Assistant
# SYSTEM_PROMPT=  (optional: override the entire system prompt)

# PDF Upload
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./data/uploads
