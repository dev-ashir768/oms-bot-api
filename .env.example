# PostgreSQL
DATABASE_URL=

# Google Gemini
# Single key:
GEMINI_API_KEY=
# OR multiple keys (comma-separated) for rate limit rotation:
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_EMBEDDING_MODEL=
GEMINI_CHAT_MODEL=

# Server
PORT=8001
NODE_ENV=development

# Logging (debug | info | warn | error)
LOG_LEVEL=debug

# FAISS
FAISS_INDEX_DIR=./data/faiss_index

# RAG Settings
RAG_TOP_K=3
CHAT_HISTORY_LIMIT=10
EMBEDDING_DIMENSION=768

# Response Cache (0.0 to 1.0 — higher = stricter match required)
CACHE_SIMILARITY_THRESHOLD=0.92

# Tracking API
TRACKING_API_URL=

# Bot Identity
BOT_NAME=Orio OMS Assistant
# SYSTEM_PROMPT=  (optional: override the entire system prompt)

# PDF Upload
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./data/uploads

# API Authentication
# Frontend must send this key in X-API-Key header on every /api/* request.
# Leave empty to disable auth (NOT recommended for production).
# Generate a strong random string, e.g. `openssl rand -hex 32`
API_KEY=
